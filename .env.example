# Base de datos PostgreSQL
# En desarrollo local contra docker-compose mapeado a 5433 (por defecto para evitar conflictos con PostgreSQL nativo):
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/sos_animales
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=sos_animales
POSTGRES_PORT=5433
# En despliegue estándar en servidor externo (puerto 5432):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sos_animales
# POSTGRES_PORT=5432

VALKEY_URL=redis://localhost:6379/0

# Plausible Analytics (opcional - solo si el usuario acepta)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_URL=

# Seguridad
SECRET_KEY=change-me

# Comunidad — umbral mínimo de votos para que comunidad sobreescriba estado oficial
COMMUNITY_VOTE_THRESHOLD=5

# Correo transaccional (Google SMTP free tier para envío de PINs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Cloudflare R2 — almacenamiento de fotos de animales
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sos-animales-fotos
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
# Autenticación administrador
ADMIN_PASSWORD_HASH=generate_with_uv_run_python_scripts_hash_admin_py
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# Logging y Diagnóstico de Base de Datos
DATABASE_ECHO=false

# Política de frescura de datos (en días)
FRESHNESS_DAYS=5
FRESHNESS_HIDE_DAYS=15
