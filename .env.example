# ==============================================================================
# SOS Animales — Environment Configuration (Single Source of Truth)
# Copy to .env (`cp .env.example .env`) and adjust values for your environment.
# ==============================================================================

# --- Docker Deployment Image & Ports ---
# ghcr.io/developmi/sos-animales:v1.0.1 for production deployment;
# sos-animales:local for local builds.
IMAGE_NAME=ghcr.io/developmi/sos-animales:v1.0.1
# Host port where FastAPI web service is published (bound to 127.0.0.1 for Caddy/reverse proxy)
WEB_PORT=8000

# --- PostgreSQL Database ---
# When running via docker compose, the 'web' service automatically resolves internal 'db:5432'.
# The URL below is used when running Python directly on the host (e.g. `make dev` or `pytest`):
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/sos_animales
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=sos_animales
# Host port mapped to PostgreSQL container (5433 avoids collisions with existing host Postgres 5432)
POSTGRES_PORT=5433
# Enable SQLAlchemy SQL query logging for diagnostics
DATABASE_ECHO=false

# --- Valkey (Redis-compatible Cache & Rate Limiting) ---
# Connection URL used when running on host; inside docker compose 'web' connects to 'redis://valkey:6379/0'
VALKEY_URL=redis://localhost:6379/0
# Host port mapped to Valkey container
VALKEY_PORT=6379

# --- Application Security & Admin Authentication ---
# Internal cryptographic signing key (at least 32 random characters)
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
# Bcrypt hash for the administrator password (generate via: uv run python scripts/hash_admin.py)
ADMIN_PASSWORD_HASH=generate_with_uv_run_python_scripts_hash_admin_py
# Secret key for signing admin JWT httpOnly session cookies (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars
# Admin JWT session expiration window in minutes
JWT_EXPIRE_MINUTES=480
# Comma-separated trusted reverse proxy IPs or CIDR ranges (Caddy, Tailscale CGNAT, Docker bridge)
TRUSTED_PROXY_IPS=127.0.0.1,::1,100.64.0.0/10,172.16.0.0/12

# --- Community & Data Governance ---
# Minimum community consensus votes required to override official campaign/point status
COMMUNITY_VOTE_THRESHOLD=5
# Days without confirmation before a record is flagged as unconfirmed (warning badge)
FRESHNESS_DAYS=5
# Days without confirmation before a stale record is hidden from default public views
FRESHNESS_HIDE_DAYS=15

# --- Transactional Email (SMTP for 4-digit PIN dispatch) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- Cloudflare R2 Object Storage (Animal Adoption Photos) ---
# Optional in local dev (falls back to a local SVG placeholder when left blank)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sos-animales-fotos
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# --- Plausible Analytics (Optional — loaded only upon explicit user consent) ---
PLAUSIBLE_DOMAIN=
PLAUSIBLE_URL=
