# Base de datos
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sos_animales

# Plausible Analytics (opcional - solo si el usuario acepta)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_URL=

# Seguridad
SECRET_KEY=change-me

# Comunidad — umbral mínimo de votos para que comunidad sobreescriba estado oficial
COMMUNITY_VOTE_THRESHOLD=5

# Correo transaccional (Google SMTP free tier para envío de PINs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 — almacenamiento de fotos de animales
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sos-animales-fotos
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
